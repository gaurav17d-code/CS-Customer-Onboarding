{
  "document_keywords": {
    "gst_certificate": ["gstin", "goods and services tax", "gst registration", "certificate of registration", "tax identification"],
    "gst_annexure": ["annexure", "gst annexure", "place of business", "additional place"],
    "pan": ["permanent account number", "income tax department", "pan card", "govt. of india"],
    "aadhaar": ["aadhaar", "aadhar", "unique identification", "uidai", "government of india"],
    "tan": ["tax deduction account number", "tan", "tds", "deduction at source"],
    "cin": ["certificate of incorporation", "company identification number", "ministry of corporate affairs", "registrar of companies", "cin"],
    "cancelled_cheque": ["cancelled", "cheque", "account no", "ifsc", "micr", "bank"],
    "work_order": ["work order", "purchase order", "supply order", "contract", "bitumen", "order no"],
    "tds_tcs_declaration": ["declaration", "tds", "tcs", "tax deducted at source", "tax collected at source", "undertaking"],
    "storage_licence": ["storage licence", "storage license", "petroleum storage", "explosive", "storage permit"],
    "noc": ["no objection certificate", "noc", "no objection", "consent"],
    "transport_licence": ["transport licence", "transport license", "vehicle permit", "goods carriage", "transport permit"],
    "end_user_certificate": ["end user certificate", "end-user", "euc", "special economic zone", "sez"]
  },
  "field_patterns": {
    "gst_certificate": {
      "gst_no": {"regex": "[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}", "keywords": ["gstin", "gst no", "registration number"]},
      "customer_name": {"regex": null, "keywords": ["legal name", "trade name", "name of business", "registered name"]},
      "address": {"regex": null, "keywords": ["principal place", "address", "premises"]},
      "state": {"regex": null, "keywords": ["state", "jurisdiction"]},
      "gst_registration_type": {"regex": null, "keywords": ["type of registration", "registration type", "composition", "regular"]}
    },
    "pan": {
      "pan_no": {"regex": "[A-Z]{5}[0-9]{4}[A-Z]{1}", "keywords": ["permanent account number", "pan"]},
      "customer_name": {"regex": null, "keywords": ["name"]}
    },
    "tan": {
      "tan_no": {"regex": "[A-Z]{4}[0-9]{5}[A-Z]{1}", "keywords": ["tan", "tax deduction account"]},
      "customer_name": {"regex": null, "keywords": ["name", "deductor name"]}
    },
    "cin": {
      "cin_no": {"regex": "[LUu][0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}", "keywords": ["cin", "company identification", "identification number"]},
      "customer_name": {"regex": null, "keywords": ["name of company", "company name", "name"]}
    },
    "cancelled_cheque": {
      "account_number": {"regex": "[0-9]{9,18}", "keywords": ["account no", "a/c no", "account number"]},
      "ifsc_code": {"regex": "[A-Z]{4}0[A-Z0-9]{6}", "keywords": ["ifsc", "ifsc code"]},
      "bank_name": {"regex": null, "keywords": ["bank", "branch"]},
      "customer_name": {"regex": null, "keywords": ["account holder", "name", "pay to"]}
    },
    "aadhaar": {
      "customer_name": {"regex": null, "keywords": ["name"]},
      "address": {"regex": null, "keywords": ["address", "s/o", "d/o", "w/o"]}
    },
    "storage_licence": {
      "customer_name": {"regex": null, "keywords": ["licensee", "granted to", "name"]},
      "licence_number": {"regex": null, "keywords": ["licence no", "license no", "permit no"]},
      "validity": {"regex": "[0-9]{2}[/-][0-9]{2}[/-][0-9]{2,4}", "keywords": ["valid upto", "valid till", "expiry", "expires"]}
    },
    "transport_licence": {
      "customer_name": {"regex": null, "keywords": ["licensee", "holder", "name"]},
      "licence_number": {"regex": null, "keywords": ["licence no", "permit no", "registration"]},
      "validity": {"regex": "[0-9]{2}[/-][0-9]{2}[/-][0-9]{2,4}", "keywords": ["valid upto", "valid till", "expiry"]}
    },
    "work_order": {
      "customer_name": {"regex": null, "keywords": ["to", "vendor", "supplier", "party"]},
      "work_order_number": {"regex": null, "keywords": ["order no", "wo no", "work order no"]},
      "validity": {"regex": "[0-9]{2}[/-][0-9]{2}[/-][0-9]{2,4}", "keywords": ["valid", "till", "date"]}
    },
    "noc": {
      "customer_name": {"regex": null, "keywords": ["granted to", "name", "party"]},
      "validity": {"regex": "[0-9]{2}[/-][0-9]{2}[/-][0-9]{2,4}", "keywords": ["valid", "till", "expiry"]}
    },
    "end_user_certificate": {
      "customer_name": {"regex": null, "keywords": ["end user", "name", "party"]}
    },
    "tds_tcs_declaration": {
      "customer_name": {"regex": null, "keywords": ["name", "deductor", "party"]},
      "tan_no": {"regex": "[A-Z]{4}[0-9]{5}[A-Z]{1}", "keywords": ["tan"]}
    }
  }
}
